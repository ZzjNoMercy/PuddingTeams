    "@puddingteams/pwcp": "workspace:*",
    "fastify": "^5.11.2",
    "fflate": "^0.8.3",
    "marked": "18.0.5",
    "parse5": "7.3.0",
    "pi-mcp-adapter": "2.31.0",
    "qrcode": "1.5.4",
