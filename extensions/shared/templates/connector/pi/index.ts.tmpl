/**
 * __DISPLAY_NAME__ Connector 的 pi 门面（双宿主包的 pi 半边，§9.5）。
 *
 * 在 pi 里注册 __CONNECTOR_ID___delegate 工具：把任务交给本机 __DISPLAY_NAME__
 * CLI（独立隔离会话）执行，返回终态文本。完整的房间能力（manager-worker
 * 编排、HITL、workspace 交接）由 PuddingTeams 提供；这里是 pi 侧的单次委托入口。
 */
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { Type } from "typebox";
import { spawnWorker } from "@puddingteams/pwcp/spawn";
import { JsonlLineParser } from "@puddingteams/pwcp/jsonl-lines";

const Params = Type.Object({
	task: Type.String({ description: "交给 __DISPLAY_NAME__ 执行的完整任务描述（独立会话，无当前对话上下文）" }),
});

export default function __CONNECTOR_ID_PASCAL__Connector(pi: ExtensionAPI) {
	pi.registerTool({
		name: "__CONNECTOR_ID___delegate",
		label: "__DISPLAY_NAME__ Delegate",
		description:
			"把任务委托给本机 __DISPLAY_NAME__ CLI（全新隔离会话）执行并返回最终结果。" +
			"它看不到当前对话，task 里要给足上下文。",
		promptSnippet: "Delegate a task to a local __DISPLAY_NAME__ agent in an isolated session",
		parameters: Params,
		async execute(_toolCallId, params, signal, onUpdate, ctx) {
			// TODO: 换成你的 CLI 的真实 argv 与事件格式。
			const parser = new JsonlLineParser();
			let content = "";
			const res = await spawnWorker({
				command: "__CONNECTOR_ID__",
				args: ["run", params.task],
				env: process.env,
				cwd: ctx.cwd,
				signal,
				timeoutMs: 900_000,
				onStdout: (chunk) => {
					for (const raw of parser.push(chunk)) {
						const evt = raw as { type?: string; text?: string };
						if (evt.type === "progress" && evt.text) {
							onUpdate?.({ content: [{ type: "text", text: evt.text }], details: undefined });
						}
						if (evt.type === "message" && evt.text) content = evt.text;
					}
				},
			});
			for (const raw of parser.flush()) {
				const evt = raw as { type?: string; text?: string };
				if (evt.type === "message" && evt.text) content = evt.text;
			}

			if (res.spawnError) {
				return {
					content: [{ type: "text", text: `无法启动 __CONNECTOR_ID__：${res.spawnError.message}` }],
					details: undefined,
				};
			}
			if (res.timedOut) {
				return { content: [{ type: "text", text: "__CONNECTOR_ID__ 执行超时（900s），已终止。" }], details: undefined };
			}
			if (res.killed) {
				return { content: [{ type: "text", text: "__CONNECTOR_ID__ 任务已取消。" }], details: undefined };
			}
			if (res.exitCode !== 0) {
				return {
					content: [{ type: "text", text: `__CONNECTOR_ID__ 执行失败（退出码 ${res.exitCode}）：${res.stderr.trim().slice(0, 400)}` }],
					details: undefined,
				};
			}
			return { content: [{ type: "text", text: content || res.stdout.trim() || "（无输出）" }], details: undefined };
		},
	});
}
